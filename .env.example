# =============================================================================
# Aigent OS — Receptionist + Dashboard — Environment Variables
# Copy this file to ".env.local" for development.
# =============================================================================

# --- Anthropic (receptionist brain behind POST /api/chat) --------------------
# Server-side only — NEVER expose this publicly.
ANTHROPIC_API_KEY=

# --- Database (Railway Postgres) ---------------------------------------------
# Single connection string. Railway provides this automatically in the deployed
# environment (reference the Postgres plugin's DATABASE_URL). It does NOT exist
# in the local sandbox. No pooler/direct split — there is no DIRECT_URL.
DATABASE_URL=

# --- Geocoding (server-side, for the map pin) --------------------------------
# Server key used by src/lib/geocode.ts to turn a vehicle's location string into
# {lat,lng}. This is NOT the browser Maps key — keep it unrestricted-by-referrer
# (or IP-restricted to your server) and enable the Geocoding API on it.
GOOGLE_GEOCODING_KEY=

# --- Google Maps JS (browser, for the dashboard map) -------------------------
# Public by design (ships in the page). Protect with HTTP-referrer restrictions
# in the Google Cloud Console, and enable the Maps JavaScript API. If unset, the
# dashboard falls back to the demo key baked into AigentOS.jsx.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
